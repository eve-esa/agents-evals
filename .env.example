# Copy to .env (gitignored). Inspect loads .env from the working directory.
# openai-api/openrouter/... reads OPENROUTER_API_KEY.
OPENROUTER_API_KEY=

# openai-api/mistral/... reads MISTRAL_API_KEY and MISTRAL_BASE_URL.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=

# inspect-wandb. Logging stays off until both of these are set.
WANDB_API_KEY=
WANDB_ENTITY=
