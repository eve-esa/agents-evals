# Copy to .env (gitignored). The notebook loads this file from the sagemaker folder.
# Inspect also reads .env from the working directory. Do not commit the filled file.

# openai-api/eve/<MODEL_NAME> reads EVE_API_KEY and EVE_BASE_URL.
# EVE_API_BASE_URL is accepted when EVE_BASE_URL is empty.
# The value is the OpenAI-compatible root, including /v1.
EVE_API_KEY=
EVE_BASE_URL=
EVE_API_BASE_URL=
MODEL_NAME=

# Optional. The second answer judge (openai/gpt-4.1-mini through OpenRouter) in section III.9.
OPENROUTER_API_KEY=

# Workshop runs stay off Weights & Biases unless you remove this line and set the keys.
WANDB_MODE=disabled
# The notebook also turns the inspect-wandb hooks off when WANDB_MODE is disabled:
# INSPECT_WANDB_MODELS_ENABLED=false and INSPECT_WANDB_WEAVE_ENABLED=false.
WANDB_API_KEY=
WANDB_ENTITY=
